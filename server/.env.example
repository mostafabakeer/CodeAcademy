# ===== إعدادات خادم DR Code (الاستضافة الإنتاجية: Supabase + Render/Koyeb) =====
# انسخ هذا الملف باسم .env ثم ضع قيمك الحقيقية

# الخادم
PORT=4000
JWT_SECRET=غيّرني-إلى-سلسلة-عشوائية-طويلة

# Supabase — من https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # يُستخدم من السيرفر فقط، لا يُكشف للعميل أبداً

# أسماء الـ buckets (أنشئها في Supabase → Storage)
SUPABASE_BUCKET_VIDEOS=videos
SUPABASE_BUCKET_IMAGES=images
SUPABASE_BUCKET_BACKUPS=backups

# تيليجرام (اختياري — مرآة ملفات الكود فقط كنسخة احتياطية)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# السلوك
SEED_ON_START=false        # true في التطوير فقط (ينشئ كورس تجريبي أول مرة)
LOG_LEVEL=info             # trace | debug | info | warn | error

# CORS (اختياري) — * للسماح للجميع
CORS_ORIGIN=*
