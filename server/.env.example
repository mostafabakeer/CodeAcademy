# ===== إعدادات خادم DR Code =====
# انسخ هذا الملف باسم .env ثم ضع قيمك الحقيقية

# منفذ الخادم (يُستخدم في Docker تلقائياً)
PORT=4000

# مفتاح سري لتشفير بيانات الدخول — غيّره إلى سلسلة عشوائية طويلة
JWT_SECRET=غيّرني-إلى-سلسلة-عشوائية-طويلة

# توكن بوت تيليجرام (اختياري) — اتركه فارغاً لو مش محتاج النسخ الاحتياطي
TELEGRAM_BOT_TOKEN=

# رقم قناة تيليجرام (اختياري) — مثل -1004356013564
TELEGRAM_CHANNEL_ID=

# إعادة مزامنة كل البيانات مع تيليجرام عند بدء التشغيل
RESYNC_ON_START=false
